{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WCH_CubeMX",
  "version": "0.1.0",
  "identifier": "dev.wchcube.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "python ../build.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": {
      "../data/mcus/*.yaml": "data/mcus/",
      "../data/packages/*.yaml": "data/packages/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Pinout and clock configurator for WCH MCUs",
    "longDescription": "STM32CubeMX-style pinout, peripheral and clock configurator for WCH RISC-V microcontrollers."
  }
}

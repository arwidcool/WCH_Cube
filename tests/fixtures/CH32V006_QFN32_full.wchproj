wchproj: 1
name: compile-gate CH32V006 QFN32
saved: fixture
mcu: CH32V006
variant: null
package: QFN32
peripherals:
  SYS:
    settings:
      Debug (SDI): 1-wire SDI (SWIO)
      External reset pin: RST enabled — ignore 12 ms (RST_MODE=10, factory default)
    remap: 2
  RCC:
    settings:
      High Speed Clock (HSE): Crystal / ceramic resonator
      Master Clock Output (MCO): Disable
    remap: 0
  DMA1:
    settings:
      Mode: Disable
    remap: 0
  IWDG:
    settings:
      Mode: Disable
    remap: 0
    params:
      write_access: Enable before writing
      prescaler: '64'
      reload: 4095
  WWDG:
    settings:
      Mode: Disable
    remap: 0
    params:
      prescaler: '1'
      window: 127
      counter: 127
  PWR:
    settings:
      Power voltage detector (PVD): Disable
      Auto wake-up (AWU): Disable
      Low-power mode entered on WFI/WFE: Sleep
    remap: 0
    params:
      pvd_level: 2.43 V rising / 2.41 V falling
      ldo_mode: Normal - LDO 1.2 V
      awu_prescaler: /4096
      awu_window: 63
  FLASH:
    settings:
      Independent watchdog start (IWDG_SW): Started by software (IWDG_SW = 1, factory default)
      Reset on entering Standby (STANDBY_RST): No reset (STANDBY_RST = 1, factory default)
      Power-on start mode (START_MODE): Boot from BOOT area (START_MODE = 1, factory default)
      Read protection (RDPR): Unprotected (RDPR = 0xA5, factory default)
    remap: 0
    params:
      latency: 2 wait states
  EXTEN:
    settings:
      Lock-up reset: Disable
      TIM2 channel 4 DMA: Own request (TIM2_CH4)
    remap: 0
    params:
      lockup: false
  EXTI:
    settings:
      EXTI line 0 trigger: Disable
      EXTI line 1 trigger: Disable
      EXTI line 2 trigger: Disable
      EXTI line 3 trigger: Disable
      EXTI line 4 trigger: Disable
      EXTI line 5 trigger: Disable
      EXTI line 6 trigger: Disable
      EXTI line 7 trigger: Disable
    remap: 0
  ADC1:
    settings:
      Channels:
        - IN3
      Regular group external trigger: Disable
      Injected group external trigger: Disable
    remap: 0
    params:
      sample: 11.5 cycles
      lowpower: false
      cont: false
      scan: false
      align: Right
  TKEY:
    settings:
      Channels: []
    remap: 0
  OPA1:
    settings:
      Positive input (PSEL): Disable
      Negative input (NSEL): Disable
      Output: Disable
    remap: 0
    params:
      poll_trigger: Software
      poll_auto: 'Off'
      setup_cfg: Setting 0
      highspeed: 'Off'
      out_ie: 'Off'
      nmi_ie: 'Off'
  TIM1:
    settings:
      Channel1: Disable
      Channel2: Disable
      Channel3: Disable
      Channel4: Disable
      Clock Source: Internal Clock
      Break Input: Disable
      Channel 1 input source: CH1 pin (TIM1_RM = 0000..1001)
    remap: 0
    params:
      prescaler: 0
      period: 65535
      counter: Up
      ckd: '1'
      arpe: false
      rcr: 0
      deadtime: 0
  TIM2:
    settings:
      Channel1: Disable
      Channel2: PWM Generation CH2
      Channel3: Disable
      Channel4: Disable
      Clock Source: Internal Clock
      Encoder Mode: Disable
      Complementary Outputs: Disable
    remap: 0
    params:
      prescaler: 23
      period: 4095
      counter: Up
      ckd: '1'
      arpe: false
  TIM3:
    settings:
      Mode: Disable
    remap: 0
    params:
      prescaler: 0
      period: 65535
      counter: Up
      ckd: '1'
      arpe: false
  USART1:
    settings:
      Mode: Asynchronous
      Hardware Flow Control: Disable
    remap: 7
    params:
      baud: 9600
      word: 8 bits
      parity: Odd
      stop: '1'
  USART2:
    settings:
      Mode: Disable
      Hardware Flow Control: Disable
    remap: 0
    params:
      baud: 115200
      word: 8 bits
      parity: None
      stop: '1'
  SPI1:
    settings:
      Mode: Full-Duplex Master
      Hardware NSS Signal: Hardware NSS Output
    remap: 3
    params:
      prescaler: '64'
      cpol: Low
      cpha: 1 Edge
      datasize: 16 bits
      firstbit: MSB First
      crc: false
  I2C1:
    settings:
      Mode: I2C
    remap: 0
    params:
      speed: 400000
      duty: '16:9'
      addrmode: 7-bit
      addr: 0
gpio_manual:
  PA5: GPIO_Output
  PA6: GPIO_Input
  PB3: GPIO_Output
  PD0: GPIO_Output
gpio_settings:
  PA5:
    mode: Output Push Pull
    pull: No pull
    speed: 30 MHz
    label: ''
  PA6:
    mode: Input
    pull: No pull
    speed: 30 MHz
    label: ''
  PB3:
    mode: Output Push Pull
    pull: No pull
    speed: 30 MHz
    label: HEARTBEAT
  PD0:
    mode: Output Push Pull
    pull: No pull
    speed: 30 MHz
    label: ''
clock:
  hse: 24
  pllIn: 0
  pllMul: 2
  sys: HSE
  pre:
    HB: 1
    ADC: 1

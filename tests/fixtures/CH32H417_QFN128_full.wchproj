    mode: Output Push Pull
    pull: No pull
    speed: Very high
    label: LED
  PC1:
    mode: Input
    pull: No pull
    speed: Low
    label: ''
  PE0:
    mode: Output Push Pull
    pull: No pull
    speed: Low
    label: ''
clock:
  hse: 25
  pllIn: 0
  pllMul: 1
  sys: HSI

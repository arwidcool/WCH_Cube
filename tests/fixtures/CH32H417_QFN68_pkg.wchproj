gpio_manual:
  PC0: GPIO_Output
  PC1: GPIO_Input
  PE0: GPIO_Output
gpio_settings:
  PC0:
    mode: Output Push Pull
    pull: No pull
    speed: Very high
    label: LED
  PC1:
    mode: Input
    pull: No pull
    speed: Low
    label: ''
  PE0:
    mode: Output Push Pull
    pull: No pull
    speed: Low
    label: ''
clock:
  hse: 25
  pllIn: 0
  pllMul: 4
  sys: HSI
  pre:
    USBFS: 10
    UHSIF: 1
    LTDC: 1
    HB: 1
    FPRE: 1
    HB2: 1
    ADC: 2
  preSrc:
    USBFS: USBHS_PLL_CLK
    RNG: SYSCLK
    I2S2: SYSCLK
    I2S3: SYSCLK
    HSADC: SYSCLK
    UHSIF: SYSCLK
    LTDC: PLLCLK
    ETH1G: ETH_PLL clock / 4
  plls:
    USBHS_PLL:
      in: 0
    ETH_PLL:
      in: 0
    USBSS_PLL:
      in: 0
    SERDES_PLL:
      in: 0
      mul: 25

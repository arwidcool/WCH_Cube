wchproj: 1
name: compile-gate CH32V005 TSSOP20
saved: fixture
mcu: CH32V005
variant: null
package: TSSOP20
peripherals:
  SYS:
    settings:
      Debug (SDI): 1-wire SDI (SWIO)
      External reset pin: RST enabled — ignore 12 ms (RST_MODE=10, factory default)
    remap: 0
  RCC:
    settings:
      High Speed Clock (HSE): Disable
      Master Clock Output (MCO): Disable
    remap: 0
  DMA1:
    settings:
      Mode: Disable
    remap: 0
  IWDG:
    settings:
      Mode: Disable
    remap: 0
    params:
      prescaler: '64'
      reload: 4095
      write_access: Enable before writing
  WWDG:
    settings:
      Mode: Disable
    remap: 0
    params:
      prescaler: '1'
      window: 127
      counter: 127
  PWR:
    settings:
      Power voltage detector (PVD): Disable
      Auto wake-up (AWU): Disable
      Low-power mode entered on WFI/WFE: Sleep
    remap: 0
    params:
      pvd_level: 2.43 V rising / 2.41 V falling
      ldo_mode: Normal - LDO 1.2 V
      awu_prescaler: /4096
      awu_window: 63
  FLASH:
    settings:
      Independent watchdog start (IWDG_SW): Started by software (IWDG_SW = 1, factory default)
      Reset on entering Standby (STANDBY_RST): No reset (STANDBY_RST = 1, factory default)
      Power-on start mode (START_MODE): Boot from BOOT area (START_MODE = 1, factory default)
      Read protection (RDPR): Unprotected (RDPR = 0xA5, factory default)
    remap: 0
    params:
      latency: 2 wait states
  EXTI:
    settings:
      EXTI line 0 trigger: Disable
      EXTI line 1 trigger: Disable
      EXTI line 2 trigger: Disable
      EXTI line 3 trigger: Disable
      EXTI line 4 trigger: Disable
      EXTI line 5 trigger: Disable
      EXTI line 6 trigger: Disable
      EXTI line 7 trigger: Disable
    remap: 0
  ADC1:
    settings:
      Channels:
        - IN2
      Regular group external trigger: Disable
      Injected group external trigger: Disable
    remap: 0
    params:
      sample: 11.5 cycles
      lowpower: false
      cont: false
      scan: false
      align: Right
  OPA1:
    settings:
      Positive input (PSEL): Disable
      Negative input (NSEL): Disable
      Output: Disable
    remap: 0
    params:
      setup_cfg: Setting 0
      highspeed: 'Off'
      out_ie: 'Off'
      nmi_ie: 'Off'
  TIM1:
    settings:
      Channel1: Disable
      Channel2: Disable
      Channel3: Disable
      Channel4: Disable
      Clock Source: Internal Clock
      Break Input: Disable
      Channel 1 input source: CH1 pin (TIM1_RM = 0000..1001)
    remap: 0
    params:
      prescaler: 0
      period: 65535
      counter: Up
      ckd: '1'
      arpe: false
      rcr: 0
      deadtime: 0
  TIM2:
    settings:
      Channel1: PWM Generation CH1
      Channel2: Disable
      Channel3: Disable
      Channel4: Disable
      Clock Source: Internal Clock
      Encoder Mode: Disable
      Complementary Outputs: Disable
    remap: 0
    params:
      prescaler: 7
      period: 1023
      counter: Up
      ckd: '1'
      arpe: false
  USART1:
    settings:
      Mode: Asynchronous
      Hardware Flow Control: Disable
    remap: 0
    params:
      baud: 57600
      word: 8 bits
      parity: None
      stop: '1'
  USART2:
    settings:
      Mode: Disable
      Hardware Flow Control: Disable
    remap: 0
    params:
      baud: 115200
      word: 8 bits
      parity: None
      stop: '1'
  SPI1:
    settings:
      Mode: Disable
      Hardware NSS Signal: Disable (software NSS)
    remap: 0
    params:
      prescaler: '16'
      cpol: Low
      cpha: 1 Edge
      datasize: 8 bits
      firstbit: MSB First
      crc: false
  I2C1:
    settings:
      Mode: I2C
    remap: 0
    params:
      speed: 400000
      duty: '2:1'
      addrmode: 7-bit
      addr: 0
gpio_manual:
  PA1: GPIO_Output
  PC0: GPIO_Output
  PC3: GPIO_Input
gpio_settings:
  PA1:
    mode: Output Push Pull
    pull: No pull
    speed: 30 MHz
    label: ''
  PC0:
    mode: Output Push Pull
    pull: No pull
    speed: 30 MHz
    label: LED
  PC3:
    mode: Input
    pull: No pull
    speed: 30 MHz
    label: ''
clock:
  hse: 24
  pllIn: 0
  pllMul: 2
  sys: HSI
  pre:
    HB: 1
    ADC: 1

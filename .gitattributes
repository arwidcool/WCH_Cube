# .gitattributes — deliberately minimal.
#
# This file ONLY marks binary types and trims release archives. It does NOT set
# `* text=auto` and it does NOT renormalise line endings, on purpose: this
# repository has agents editing it continuously, and a global text rule would
# rewrite every existing file on the next commit in one enormous diff whose only
# content is line endings. If the tree is ever cleaned up to consistent endings,
# that belongs in its own commit with nothing else in it.
#
# What is here earns its place:
#
# 1. Binary types. Without these, git may try to merge or diff them, and a
#    line-ending conversion could corrupt them outright. Screenshots and PDFs are
#    the ones that matter in this repo — docs/images/ is regenerated by
#    tools/capture_docs_images.js and data/sources/ holds the vendor PDFs.
#
# 2. export-ignore. `git archive` and GitHub's "Download ZIP" honour these, so a
#    release tarball does not carry 45+ MB of the vendor's SDK and datasheets that
#    we do not own and that nobody needs in order to build or run the app.
#    `git clone` is unaffected — the files stay in the repository.

# ---------------------------------------------------------------- binary types
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.woff      binary
*.woff2     binary
*.ttf       binary

# Anything the RISC-V toolchain or Tauri produces, in case one is ever committed
# by accident rather than ignored.
*.o         binary
*.a         binary
*.elf       binary
*.bin       binary
*.hex       binary
*.exe       binary

# ------------------------------------------------------- release archives only
# The vendor's material: theirs, large, and not needed to build the app. Each part
# folder is listed separately so the tree stays readable and a new part is an
# obvious one-line addition.
data/sources/**/Datasheets/**   export-ignore
data/sources/**/datasheets/**   export-ignore
data/sources/**/Evt/**          export-ignore
data/sources/**/evt/**          export-ignore

# Agent history: the decision record, useful in the repository, not in a release.
agents/history/**               export-ignore

# Evidence and fixtures are for the test suite, not for people who downloaded a
# binary. tests/ itself stays — the suites are worth reading.
tests/evidence/**               export-ignore

# NOT listed, and deliberately: `data/Pio Source/` is the human's read-only copy of
# the installed PlatformIO platform. It is already in .gitignore, so it is not in the
# repository and has nothing to exclude from an archive — and its path contains a
# space, which gitattributes patterns cannot carry unquoted.
